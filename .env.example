UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Gemini — from aistudio.google.com, free tier. Only used for embeddings in
# Phase 3 now; vision moved to local Ollama (see BUILDLOG.md).
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=gemini-embedding-001

# Ollama (local vision model) — runs as a docker-compose service, defaults
# below work as-is inside docker-compose, no key needed.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_VISION_MODEL=llava

DATABASE_URL=postgresql://imagematch:imagematch@db:5432/imagematch
